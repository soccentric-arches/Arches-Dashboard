# Python bytecode caches (contract-tests/ is pytest-based).
__pycache__/
*.pyc
*.pyo

# Node (webui/ has its own, more thorough .gitignore; this is a repo-root
# backstop in case files end up outside it).
node_modules/
.next/

# Docker persistent data (config, env files, container logs) — host-mounted
# into the container by docker/Makefile. Keep the folder structure, not
# its runtime contents.
/data/*
!/data/config/
!/data/logs/
/data/config/*
!/data/config/.gitkeep
/data/logs/*
!/data/logs/.gitkeep
